# OpenClaw gateway: TLS terminates here, HTTP to Docker-published port.
# Gmail Pub/Sub push -> gog watch serve (127.0.0.1:8788, path /); public URL is /gmail-pubsub
#
# WebSockets must NOT go through `encode` — compression breaks the Upgrade handshake (browser sees WS close 1006).
board.sonofwolf.org {
	@protected not path /manifest.json /sw.js /icon.svg
	basic_auth @protected {
		adriel {env.BOARD_BASICAUTH_HASH}
	}
	reverse_proxy 127.0.0.1:3334
}

browser-2ca0d4.sonofwolf.org {
	@websockets {
		header Connection *Upgrade*
		header Upgrade websocket
	}
	handle @websockets {
		reverse_proxy 127.0.0.1:3000 {
			flush_interval -1
		}
	}
	handle {
		reverse_proxy 127.0.0.1:3000
	}
}

ai.sonofwolf.org {
	handle_path /gmail-pubsub* {
		reverse_proxy 127.0.0.1:8788
	}
	handle /trello* {
		reverse_proxy 127.0.0.1:18990
	}
	handle /github-pr* {
		reverse_proxy 127.0.0.1:19091
	}

	route {
		@websockets {
			header Connection *Upgrade*
			header Upgrade websocket
		}
		handle @websockets {
			reverse_proxy 127.0.0.1:18789 {
				flush_interval -1
			}
		}
		handle {
			encode zstd gzip
			reverse_proxy 127.0.0.1:18789
		}
	}
}
